{
  "extends": "@canonical/typescript-config-react",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "api/*": ["src/api/*"],
      "context/*": ["src/context/*"],
      "components/*": ["src/components/*"],
      "lib/*": ["src/lib/*"],
      "pages/*": ["src/pages/*"],
      "types/*": ["src/types/*"],
      "util/*": ["src/util/*"],
      "*": ["types/*.d.ts"]
    },
    "module": "esnext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "sourceMap": false
  },
  "include": [
    "src",
    "vite.config.ts",
    "public/assets/js/manifest.js"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
