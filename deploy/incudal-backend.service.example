[Unit]
Description=PayIncus backend API
Documentation=https://github.com/VipMaxxxx/payincus
After=network.target postgresql.service redis-server.service
Wants=network.target

[Service]
Type=simple
User=incudal
Group=incudal
WorkingDirectory=/opt/incudal/current
EnvironmentFile=/opt/incudal/.env
Environment=HOME=/opt/incudal
Environment=PATH=/usr/local/libexec/incudal:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 服务启动时自动通过内置 Goose 迁移对比数据库版本并按需执行，无需单独 ExecStartPre 迁移命令
ExecStart=/opt/incudal/current/server/incudal-server

Restart=on-failure
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65536

# Online updates start root-owned systemd oneshot units through a restricted
# sudoers rule. Keep this false or sudo cannot elevate from the backend service.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/incudal /opt/incudal/current /opt/incudal/releases /opt/incudal/server/certs /opt/incudal/.npm /opt/incudal/.cache /opt/incudal/.git /opt/incudal/update-logs
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=incudal-backend

[Install]
WantedBy=multi-user.target
